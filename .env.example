# Copy to .env and fill in locally. Never commit real keys.
# Prefer GEMINI_API_KEY. GOOGLE_API_KEY or LLM_API_KEY also work.
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=20
# Development default: all origins. Production: comma-separated allowlist.
CORS_ORIGINS=*
